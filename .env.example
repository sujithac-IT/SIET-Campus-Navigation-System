# SIET Campus Navigation System - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL + PostGIS Database
DATABASE_URL=postgresql://siet_admin:siet_secure_password_2026@localhost:5432/siet_campus_db?schema=public

# Redis Cache & BullMQ
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_ACCESS_SECRET=siet_super_secret_jwt_access_key_min_32_chars_2026
JWT_REFRESH_SECRET=siet_super_secret_jwt_refresh_key_min_32_chars_2026
COOKIE_SECRET=siet_cookie_secret_passphrase_2026

# AI Assistant
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Firebase Cloud Messaging (Push)
FIREBASE_PROJECT_ID=siet-navigate-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@siet-navigate.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Client Public Env
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
