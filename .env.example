# Database Connection URL (PostgreSQL + PostGIS)
DATABASE_URL="postgresql://campus_user:campus_password@localhost:5432/campus_nav_db?sslmode=disable"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# Authentication & Session Security Key
AUTH_SECRET="your_argon2_or_jwt_secret_key_here"

# Map Tiles & Provider Config
NEXT_PUBLIC_MAP_STYLE="https://demotiles.maplibre.org/style.json"
MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# AI RAG Vector Store & Provider Config
AI_API_KEY="your_ai_provider_api_key"

# Email & SMS Notification Providers
EMAIL_PROVIDER="smtp://user:pass@smtp.siet.ac.in:587"
SMS_PROVIDER="twilio"

# Object Storage Endpoint for Floor Maps & Images
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="siet-campus-assets"
